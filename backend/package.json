{
  "name": "methodica-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:local": "prisma generate && node scripts/dev-local.mjs",
    "build": "prisma generate && tsc && node scripts/build-vercel.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "npm run build && tsx --test test/api.test.ts test/deployment.test.ts test/auth.test.ts test/workspace-import.test.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@prisma/dev": "^0.25.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "prisma": "^7.10.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1"
  }
}
